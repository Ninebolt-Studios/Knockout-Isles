      <key>IsRemovable</key><true/>
      <key>Label</key><string>Knockout Isles</string>
      <key>PayloadDescription</key><string>Adds the Knockout Isles party brawler to your Home Screen. It always opens the newest version.</string>
      <key>PayloadDisplayName</key><string>Knockout Isles</string>
      <key>PayloadIdentifier</key><string>io.github.ninebolt-studios.knockoutisles.webclip</string>
